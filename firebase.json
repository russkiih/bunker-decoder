{
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [{"source": "**", "headers": [
        {"key": "Permissions-Policy", "value": "microphone=(self)"},
        {"key": "Cache-Control", "value": "no-cache"}]}]
    },
    {
      "target": "legacy",
      "public": "legacy",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [{"source": "**", "headers": [
        {"key": "Cache-Control", "value": "no-cache"}]}]
    }
  ]
}
